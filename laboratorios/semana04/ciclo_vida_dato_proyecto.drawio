          </mxGeometry>
        </mxCell>
        <mxCell id="8JdqYQEFSVhWbarXvoHD-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Retención&lt;ul style=&quot;margin: 16px 0px; padding-left: 18px; color: rgb(249, 250, 251); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; text-align: start; background-color: rgb(21, 21, 23);&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Qué ocurre:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; El teléfono se conserva mientras el visitante tenga relación activa con la instalación.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Responsable:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; Administrador de base de datos.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;margin-top: 6px;&quot;&gt;&lt;p class=&quot;ds-markdown-paragraph&quot; style=&quot;margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px;&quot;&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;Control:&lt;/span&gt;&lt;span class=&quot;&quot;&gt; Plazo definido de 12 meses. Revisión trimestral para eliminar registros sin actividad.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="1070" y="300" as="geometry" />
        </mxCell>
        <mxCell id="8JdqYQEFSVhWbarXvoHD-15" edge="1" parent="1" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
